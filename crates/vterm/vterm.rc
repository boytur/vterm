#define IDI_ICON 0x101

IDI_ICON ICON "../../assets/AppIcon.ico"

1 VERSIONINFO
FILEVERSION 0,5,0,0
PRODUCTVERSION 0,5,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "vterm"
            VALUE "FileDescription", "vterm - GPU-accelerated terminal emulator"
            VALUE "FileVersion", "0.5.0"
            VALUE "InternalName", "vterm"
            VALUE "LegalCopyright", "Copyright (c) 2026 vterm contributors"
            VALUE "OriginalFilename", "vterm.exe"
            VALUE "ProductName", "vterm"
            VALUE "ProductVersion", "0.5.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
